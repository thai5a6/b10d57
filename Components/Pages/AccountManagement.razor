@page "/"
@inject AccountService Svc
@inject NotificationService Notify
@inject DialogService Dialog

<PageTitle>Quản lý tài khoản</PageTitle>

<div class="container-card">
    <h1 class="block-title"><RadzenIcon Icon="star" class="title-star" />QUẢN LÝ TÀI KHOẢN</h1>

    <div class="grey-panel">

        @* ===== Menu mục (bên trái) ===== *@
        <aside class="side-nav">
            <nav>
                <a href="#ten-hien-thi"><RadzenIcon Icon="badge" />Tên hiển thị</a>
                <a href="#ca-nhan"><RadzenIcon Icon="contact_page" />Thông tin cá nhân</a>
                <a href="#mat-khau"><RadzenIcon Icon="key" />Mật khẩu</a>
                <a href="#mfa"><RadzenIcon Icon="verified_user" />Xác thực nhiều lớp</a>
                <a href="#phien"><RadzenIcon Icon="lock" />Quản lý đăng nhập</a>
                <a href="#thong-bao"><RadzenIcon Icon="forum" />Tùy chọn thông báo</a>
            </nav>
        </aside>

        <main class="content">

            @if (showMfaBanner && !Svc.Current.MfaEnabled)
            {
                <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter"
                             AllowClose="true" Close="@(() => showMfaBanner = false)"
                             Title="Xác thực nhiều lớp đã sẵn sàng" class="mfa-banner">
                    <div>Bật xác thực nhiều lớp (MFA) để bảo vệ tài khoản và dữ liệu tài sản của đơn vị.</div>
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" class="rz-mt-3">
                        <RadzenButton Text="Tìm hiểu thêm" ButtonStyle="ButtonStyle.Light" Style="flex:1" Click="ShowMfaInfo" />
                        <RadzenButton Text="Bật MFA" ButtonStyle="ButtonStyle.Primary" Style="flex:1" Click="@(() => EnableMfa(true))" />
                    </RadzenStack>
                </RadzenAlert>
            }

            <SectionCard Id="ten-hien-thi" Title="Tên hiển thị"
                         Description="Tên hiển thị được dùng để nhận diện bạn trong các phiếu bàn giao và nhật ký thu hồi.">
                <div class="field-row">
                    <RadzenFormField Text="Tên hiển thị" Variant="Variant.Filled" Style="flex:2">
                        <RadzenTextBox @bind-Value="displayName" MaxLength="30" />
                    </RadzenFormField>
                    <RadzenFormField Text="Mã đơn vị" Variant="Variant.Filled" Style="flex:1">
                        <Start><span class="hash">#</span></Start>
                        <ChildContent><RadzenTextBox @bind-Value="tagline" MaxLength="6" /></ChildContent>
                    </RadzenFormField>
                </div>
                <div class="actions">
                    <RadzenButton Text="Lưu thay đổi" ButtonStyle="ButtonStyle.Primary"
                                  Disabled="@(!ProfileChanged)" Click="SaveProfile" />
                </div>
            </SectionCard>

            <SectionCard Id="ca-nhan" Title="Thông tin cá nhân"
                         Description="Thông tin này dùng để xác định người chịu trách nhiệm khi bàn giao hoặc thu hồi tài sản.">
                <div class="field-grid">
                    <RadzenFormField Text="Họ và tên" Variant="Variant.Filled">
                        <RadzenTextBox @bind-Value="fullName" />
                    </RadzenFormField>
                    <RadzenFormField Text="Mã cán bộ / học viên" Variant="Variant.Filled">
                        <RadzenTextBox Value="@Svc.Current.StaffCode" ReadOnly="true" />
                    </RadzenFormField>
                    <RadzenFormField Text="Email" Variant="Variant.Filled">
                        <RadzenTextBox @bind-Value="email" />
                    </RadzenFormField>
                    <RadzenFormField Text="Số điện thoại" Variant="Variant.Filled">
                        <RadzenTextBox @bind-Value="phone" />
                    </RadzenFormField>
                    <RadzenFormField Text="Đơn vị" Variant="Variant.Filled">
                        <RadzenTextBox @bind-Value="unit" />
                    </RadzenFormField>
                    <RadzenFormField Text="Cấp bậc" Variant="Variant.Filled">
                        <RadzenDropDown @bind-Value="rank" Data="ranks" />
                    </RadzenFormField>
                    <RadzenFormField Text="Ngày sinh" Variant="Variant.Filled">
                        <RadzenDatePicker @bind-Value="dob" DateFormat="dd/MM/yyyy" />
                    </RadzenFormField>
                </div>
                <div class="actions">
                    <RadzenButton Text="Lưu thay đổi" ButtonStyle="ButtonStyle.Primary" Click="SavePersonal" />
                </div>
            </SectionCard>

            <SectionCard Id="mat-khau" Title="Mật khẩu"
                         Description="Dùng mật khẩu tối thiểu 8 ký tự, gồm cả chữ và số.">
                <RadzenStack Gap="1rem">
                    <RadzenFormField Text="Mật khẩu hiện tại" Variant="Variant.Filled">
                        <RadzenPassword @bind-Value="oldPwd" />
                    </RadzenFormField>
                    <RadzenFormField Text="Mật khẩu mới" Variant="Variant.Filled">
                        <RadzenPassword @bind-Value="newPwd" />
                    </RadzenFormField>
                    <RadzenFormField Text="Nhập lại mật khẩu mới" Variant="Variant.Filled">
                        <RadzenPassword @bind-Value="confirmPwd" />
                    </RadzenFormField>
                    @if (!string.IsNullOrEmpty(pwdError))
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Dark" AllowClose="false">@pwdError</RadzenAlert>
                    }
                </RadzenStack>
                <div class="actions">
                    <RadzenButton Text="Đổi mật khẩu" ButtonStyle="ButtonStyle.Primary" Click="ChangePassword" />
                </div>
            </SectionCard>

            <SectionCard Id="mfa" Title="Xác thực nhiều lớp"
                         Description="Yêu cầu thêm mã xác nhận mỗi khi đăng nhập từ thiết bị mới.">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                    <RadzenSwitch Value="Svc.Current.MfaEnabled" Change="@((bool v) => EnableMfa(v))" />
                    <span>@(Svc.Current.MfaEnabled ? "Đang bật" : "Đang tắt")</span>
                </RadzenStack>
            </SectionCard>

            <SectionCard Id="phien" Title="Quản lý đăng nhập"
                         Description="Các thiết bị đang đăng nhập vào tài khoản của bạn.">
                <RadzenDataGrid Data="Svc.Current.Sessions" TItem="LoginSession" AllowPaging="false" class="session-grid">
                    <Columns>
                        <RadzenDataGridColumn TItem="LoginSession" Property="Device" Title="Thiết bị">
                            <Template Context="s">
                                @s.Device
                                @if (s.IsCurrent) { <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Phiên này" class="rz-ms-2" /> }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="LoginSession" Property="IpAddress" Title="Địa chỉ IP" Width="120px" />
                        <RadzenDataGridColumn TItem="LoginSession" Property="LastActive" Title="Hoạt động cuối" FormatString="{0:dd/MM/yyyy HH:mm}" Width="170px" />
                        <RadzenDataGridColumn TItem="LoginSession" Title="" Width="130px" Sortable="false">
                            <Template Context="s">
                                @if (!s.IsCurrent)
                                {
                                    <RadzenButton Text="Đăng xuất" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger"
                                                  Variant="Variant.Outlined" Click="@(() => SignOut(s.Id))" />
                                }
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
                <div class="actions">
                    <RadzenButton Text="Đăng xuất mọi thiết bị khác" ButtonStyle="ButtonStyle.Danger"
                                  Variant="Variant.Outlined" Click="SignOutOthers" />
                </div>
            </SectionCard>

            <SectionCard Id="thong-bao" Title="Tùy chọn thông báo"
                         Description="Chọn loại thông báo bạn muốn nhận.">
                <RadzenStack Gap="1.25rem">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                        <RadzenSwitch @bind-Value="Svc.Current.NotifyEmail" /><span>Nhận thông báo qua email</span>
                    </RadzenStack>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                        <RadzenSwitch @bind-Value="Svc.Current.NotifyRecovery" /><span>Có đợt thu hồi tài sản mới</span>
                    </RadzenStack>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                        <RadzenSwitch @bind-Value="Svc.Current.NotifyOverdue" /><span>Tài sản quá hạn bàn giao</span>
                    </RadzenStack>
                </RadzenStack>
            </SectionCard>

        </main>
    </div>
</div>

@code {
    bool showMfaBanner = true;

    string displayName = "", tagline = "";
    string fullName = "", email = "", phone = "", unit = "", rank = "";
    DateTime? dob;
    string oldPwd = "", newPwd = "", confirmPwd = "", pwdError = "";

    readonly string[] ranks =
        { "Học viên", "Thiếu úy", "Trung úy", "Thượng úy", "Đại úy", "Thiếu tá", "Trung tá", "Thượng tá", "Đại tá" };

    bool ProfileChanged => displayName != Svc.Current.DisplayName || tagline != Svc.Current.Tagline;

    protected override void OnInitialized()
    {
        var a = Svc.Current;
        displayName = a.DisplayName; tagline = a.Tagline;
        fullName = a.FullName; email = a.Email; phone = a.Phone;
        unit = a.Unit; rank = a.Rank; dob = a.DateOfBirth;
    }

    void SaveProfile()
    {
        if (string.IsNullOrWhiteSpace(displayName))
        {
            Notify.Notify(NotificationSeverity.Error, "Chưa lưu được", "Tên hiển thị không được để trống.");
            return;
        }
        Svc.UpdateProfile(displayName, tagline);
        tagline = Svc.Current.Tagline;
        Notify.Notify(NotificationSeverity.Success, "Đã lưu", "Tên hiển thị đã được cập nhật.");
    }

    void SavePersonal()
    {
        if (string.IsNullOrWhiteSpace(fullName) || !email.Contains('@'))
        {
            Notify.Notify(NotificationSeverity.Error, "Chưa lưu được", "Kiểm tra lại họ tên và email.");
            return;
        }
        Svc.UpdatePersonal(fullName, email, phone, unit, rank, dob);
        Notify.Notify(NotificationSeverity.Success, "Đã lưu", "Thông tin cá nhân đã được cập nhật.");
    }

    void ChangePassword()
    {
        pwdError = "";
        if (newPwd != confirmPwd) { pwdError = "Mật khẩu nhập lại không khớp."; return; }
        var err = Svc.ChangePassword(oldPwd, newPwd);
        if (err is not null) { pwdError = err; return; }
        oldPwd = newPwd = confirmPwd = "";
        Notify.Notify(NotificationSeverity.Success, "Đã đổi mật khẩu", "Dùng mật khẩu mới ở lần đăng nhập sau.");
    }

    void EnableMfa(bool on)
    {
        Svc.SetMfa(on);
        Notify.Notify(on ? NotificationSeverity.Success : NotificationSeverity.Warning,
            on ? "Đã bật MFA" : "Đã tắt MFA");
    }

    void SignOut(Guid id)
    {
        Svc.SignOutSession(id);
        Notify.Notify(NotificationSeverity.Info, "Đã đăng xuất thiết bị");
    }

    void SignOutOthers()
    {
        Svc.SignOutOthers();
        Notify.Notify(NotificationSeverity.Info, "Đã đăng xuất các thiết bị khác");
    }

    async Task ShowMfaInfo() =>
        await Dialog.Alert("MFA yêu cầu thêm một mã xác nhận ngoài mật khẩu, nên kể cả khi lộ mật khẩu thì người khác vẫn không đăng nhập được.",
                           "Xác thực nhiều lớp là gì?", new AlertOptions { OkButtonText = "Đã hiểu" });
}
